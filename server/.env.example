# Copy this file to .env for local development.
# On Render, set these as Environment Variables in the dashboard instead —
# do not commit a real .env file.

PORT=4000

# Postgres connection string. Render's managed Postgres gives you this
# as the "Internal Database URL" (or "External" if connecting from outside Render).
DATABASE_URL=postgres://user:password@localhost:5432/gobaris

# From the Razorpay Dashboard → Settings → API Keys.
# Use your Test Mode keys until you're ready to go live (no KYC needed for testing).
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx

# Comma-separated list of origins allowed to call this API, e.g.:
# https://gobarissoilcare.github.io,http://localhost:8098
ALLOWED_ORIGINS=http://localhost:8098
